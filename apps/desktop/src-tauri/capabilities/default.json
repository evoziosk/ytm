{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "local-ui",
  "description": "Bundled companion windows only.",
  "local": true,
  "windows": ["settings", "mini", "party", "lyrics", "search"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:window:allow-hide",
    "allow-get-snapshot",
    "allow-control-status",
    "allow-queue-track",
    "allow-remote-status",
    "allow-remote-connect",
    "allow-remote-disconnect",
    "allow-remote-discover",
    "allow-remote-request",
    "allow-control-start",
    "allow-control-end",
    "allow-control-participant",
    "allow-control-rotate",
    "allow-send-command",
    "allow-retry-playback",
    "allow-dismiss-playback-error",
    "allow-queue-action",
    "allow-save-settings",
    "allow-set-window-blur",
    "allow-open-panel",
    "allow-show-music",
    "allow-party-connect",
    "allow-party-leave",
    "allow-party-transfer",
    "allow-get-lyrics",
    "allow-music-query",
    "allow-play-items",
    "allow-open-account",
    "allow-logout-account",
    "allow-refresh-music"
  ]
}
