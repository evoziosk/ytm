{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "audio-sharing",
  "description": "Virtual microphone controls only in the bundled Preferences window.",
  "local": true,
  "windows": ["settings"],
  "permissions": [
    "allow-audio-status",
    "allow-audio-devices",
    "allow-audio-apply",
    "allow-audio-stop",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://vb-audio.com/Cable/" }]
    }
  ]
}
