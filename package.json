{
  "name": "ytm-listen",
  "version": "0.5.2",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "pnpm --filter @ytm/desktop dev",
    "desktop": "pnpm --filter @ytm/desktop tauri dev",
    "build": "pnpm --filter @ytm/bridge build && pnpm --filter @ytm/desktop build",
    "check": "pnpm -r typecheck",
    "lint": "prettier --check \"**/*.{js,ts,svelte,css,json,yml,yaml,md}\"",
    "format": "prettier --write \"**/*.{js,ts,svelte,css,json,yml,yaml,md}\"",
    "test": "pnpm -r test",
    "relay:dev": "pnpm --filter @ytm/relay dev",
    "types:generate": "cargo run -p ytm-protocol --bin export-types"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "typescript": "~5.9.3",
    "vitest": "~4.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
